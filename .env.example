# Base de données Neon (pooled connection string)
DATABASE_URI=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Payload — générer une valeur aléatoire longue
PAYLOAD_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin — seed du premier compte (mot de passe requis à chaque login sauf appareil de confiance)
SEED_ADMIN_EMAIL=bertrandwebdesigner@proton.me
SEED_ADMIN_PASSWORD=

# Bypass login 1 clic — UNIQUEMENT en local/dev (ignoré en production)
ENABLE_ADMIN_TEST_LOGIN=false
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=

# Stockage médias (requis en prod — plugin activé si présent)
BLOB_READ_WRITE_TOKEN=

# Email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
